# Copy to .env and point at local checkpoints to run without downloading from the Hub.
# Every variable is optional: anything left unset falls back to the Hugging Face Hub.

# Directory holding the LM (config.json, model.safetensors, tokenizer.json).
# May also be a Hub repo id.
KOVA_MODEL_PATH=

# Codec checkpoint file.
KOVA_CODEC_PATH=

# WavLM-large directory, used only when encoding audio (voice cloning, dataset prep).
# May also be a Hub repo id; defaults to microsoft/wavlm-large.
KOVA_WAVLM_PATH=

# Directory of LoRA adapters, one subdirectory per voice.
KOVA_LORA_DIR=

# Hub repo used for anything not resolved above.
KOVA_HUB_REPO=

# A local speech wav used by the codec round-trip tests. Unset skips them; no audio is
# committed to this repository.
KOVA_TEST_AUDIO=

# A directory of your own recordings, and optionally a CSV/JSONL naming their transcripts,
# used by the dataset-preparation end-to-end test. Unset skips it; no audio is committed to
# this repository.
KOVA_TEST_AUDIO_DIR=
KOVA_TEST_AUDIO_METADATA=

# Maps the voice names OpenAI clients send onto voices installed here, for the compatible
# endpoint. Comma separated, e.g. KOVA_VOICE_ALIASES="alloy=my_voice,nova=other_voice".
# Unmapped stock names speak in the base voice; `kova-tts serve --voice-alias` overrides this.
KOVA_VOICE_ALIASES=
