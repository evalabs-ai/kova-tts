# Local model paths and secrets — never published
.env
.env.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Model weights and generated audio
*.ckpt
*.safetensors
*.pt
*.bin
# No audio is ever committed to this repository, including test fixtures: every
# recording carries licensing and voice-likeness questions we do not want to inherit.
# Tests synthesize their own signals, or read a local file via KOVA_TEST_AUDIO.
*.wav
*.mp3
*.flac
*.ogg
*.opus
*.m4a
# Exceptions, kept narrow on purpose. The demo's zero-shot presets: every clip was generated by a Kova
# checkpoint prompted with no voice -- no recording of any person -- so none of the above
# applies (provenance in apps/demo/zero_shot_voices/README.md).
!apps/demo/zero_shot_voices/*.flac
# And the README's four voice samples, the same snippets published on the Hugging Face model
# card. The voices themselves are not released.
!assets/samples/*.mp3

# Run outputs
outputs/
runs/
wandb/
site/

.DS_Store
