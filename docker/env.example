# Copy to docker/.env -- compose reads it automatically. Everything here is optional.
#
# This is compose's configuration, not the model's: it names directories *on your host* and
# where they land inside the container. The repository's own .env is a different file and the
# image ignores it on purpose (see KOVA_DISABLE_DOTENV in the Dockerfile).
#
# Leave the whole file empty to download from the Hugging Face Hub instead -- except
# KOVA_WEIGHTS_DIR, which compose still needs something to mount; point it at any directory.

# One host directory holding your checkpoints. Mounted read-only at /weights.
KOVA_WEIGHTS_DIR=/path/to/checkpoints

# Where each artifact lives *inside* /weights. Unset any of these to fall back to the Hub.
KOVA_MODEL_PATH=/weights/model
KOVA_CODEC_PATH=/weights/codec.pt
KOVA_LORA_DIR=/weights/loras

# WavLM is only read when encoding audio: voice cloning and dataset preparation. Unset to pull
# microsoft/wavlm-large from the Hub into the cached volume on first use.
KOVA_WAVLM_PATH=/weights/wavlm-large

# The Hub repository anything above falls back to.
KOVA_HUB_REPO=

# For a gated repository, or before the released weights are public.
HF_TOKEN=

# Host ports. Change these, not the container-side ports in compose.yml.
KOVA_PORT=8000
KOVA_DEMO_PORT=7860
